.TH man 3 "9 Aout 2025" "0.3-1" "json2txt header man page"
.SH NAME
json2txt.h
.SH SYNOPSIS
json2txt library documentation
.SH DESCRIPTION
.TP
.EX
#define INIT_JSON(BUFSIZE, ALLOC_SIZE, CHARS, buffer) { 0, BUFSIZE, ALLOC_SIZE, CHARS, buffer, NULL, 0, 0, 1, NULL, NULL, 0 }
.EE
.TP
.EX
\fBenum TYPE\fR{
	ARRAY = 1,
	PAIR = 2
};
.EE
.TP
.EX
\fBenum VAL\fR{
	VOID = 0,
	STRING = 1,
	INT = 2,
	WARN = 4,
	WARN_NBR = 8,
	WARN_BOOL = 16,
	SET = 32
};
.EE
.TP
.EX
\fBenum KIND\fR{
	NEW,
	SUB,
	NEXT
};
.EE
.TP
struct json_parser
.EX
\fBstruct json_parser\fR{
	\fBint\fR file;				/*file descriptor(FD) to analyse*/
	\fBunsigned\fR int buflen;	/*len of the buffer used for read the FD*/
	\fBsize\fR_t stock_buf;		/*stock buffer size to increment*/
	\fBchar\fR *chars;			/*chars to exclude (eg:" \\t\\n")*/
	\fBchar\fR *buffer;			/*buffer used tor read the FD*/
	\fBchar\fR *buf;			/*pointer used for read buffer*/
	\fBsize\fR_t len;			/*len of stock*/
	\fBssize_t\fR r_len;			/*len read by read_fn*/
	\fBssize_t\fR offset;		/*position in the FD*/
	\fBchar\fR *pstock;			/*pointer to stock for write in stock*/
	\fBchar\fR *stock;			/*the stockage buffer*/
	\fBsize_t\fR stock_size;		/*size of stock*/
	\fBsize_t\fR depth;			/*Depth of JSON object*/
	\fBsize_t\fB data_size;			/*Size of JSON data*/
};
.EE
.BR
.TP
struct json
.EX
\fBstruct json\fR{
	\fBenum TYPE\fR type;			/*Type of data*/
	\fBint\fR t_val;				/*Type of Value of the data*/
	\fBstruct\fR{
		\fBunion\fR{
			\fBsize_t\fR index;		/*index in array*/
			\fBchar\fR *key;		/*key name of this entry*/
		}name;
		\fBchar\fR *value;			/*value of this entry if she is set*/
	}value;
	\fBstruct\fR json *next;
	\fBstruct\fR json *prev;
	\fBstruct\fR json *sub;
	\fBstruct\fR json *up;
};
.EE
.BR
.TP
json_new_lst, fn: for function:
.EX
\fBstruct json_new_lst\fR{
	\fBstruct json\fR *j;		/*new sub json*/
	\fBint\fR json_err;			/*stock the current possible error*/
	#if __WORDSIZE != 32
		int ___;
	#endif
	\fBstruct json_new_lst\fR *prev;
	\fBstruct json_new_lst\fR *next;
};
\fBstruct fn\fR{
	\fBsize_t\fR index;
	\fBssize_t\fR offset;
	\fBint\fR key;
	\fBint\fR value;
	\fBint\fR c_end;
	\fBint\fR err;
	\fBstruct\fR{
		\fBunion\fR{
			\fBint\fR (*get_it)(\fBstruct json_parser\fR *, ...);
			\fBint\fR (*get_str)(\fBstruct json_parser\fR *);
			\fBint\fR (*get_int)(\fBstruct json_parser\fR *, \fBint\fR);
		}get;
		\fBunion\fR{
			\fBvoid\fR (*up_it)(\fBstruct json\fR **,...);
			\fBvoid\fR (*up_from_array)(\fBstruct json\fR **, \fBstruct json_parser\fR *, \fBstruct fn\fR *);
			\fBvoid\fR (*up_from_pair)(\fBstruct json\fR **, \fBstruct json_parser\fR *);
			\fBvoid\fR (*up_int)(\fBstruct json\fR **, \fBstruct json_parser\fR *, \fBstruct fn\fR *);
		}up;
		\fBunion\fR{
			\fBvoid\fR (*up_string)(\fBstruct json_parser\fR *, ...);
			\fBvoid\fR (*up_int)(\fBstruct json_parser\fR *, ...);
			\fBvoid\fR (*up_from_string)(\fBstruct json_parser\fR *, \fBstruct fn\fR *);
			\fBvoid\fR (*up_int_from_array)(\fBstruct json_parser\fR *, \fBstruct json\fR *, \fBstruct fn\fR *);
			\fBvoid\fR (*up_int_from_pair)(\fBstruct json_parser\fR *, \fBstruct json\fR *);
		}structure;
		union{
			\fBint\fR (*do_it)(\fBstruct json_parser\fR *, ...);
			\fBint\fR (*read_with_this)(\fBstruct json_parser\fR *, \fBstruct json\fR **,
									\fBstruct fn\fR **, \fBstruct json_new_lst\fR **);
			\fBint\fR (*do_errors)(\fBstruct json_parser\fR *, \fBstruct json\fR **, \fBstruct fn\fR **);
		}do_it;
		union{
			\fBint\fR (*do_it)(\fBstruct json_parser\fR *, ...);
			\fBint\fR (*read_with_this)(\fBstruct json_parser\fR *, \fBstruct json\fR **,
									\fBstruct fn\fR **, \fBstruct json_new_lst\fR **);
			\fBint\fR (*do_errors)(\fBstruct json_parser\fR *, \fBstruct json\fR **, \fBstruct fn\fR **);
		}do_it;
	}fns;
	\fBstruct fn\fR *next;
	\fBstruct fn\fR *prev;
};
.EE
.BR
.TP
\fBextern int json_err\fR;
0 < json_err < 128	libc errors
    json_err < 0	json library errors 
.BR
.TP
\fBssize_t\fR read_fn(\fBstruct json_parser\fR *p);
Read the json FD;
.EX
return: 	-1 => on error
		0  => Success
.EE
.BR
.TP
\fBvoid\fR readchar(\fBssize_t\fR *offset, \fBchar\fR **str, const \fBchar\fR *not);
Read the json buffer and squize chars, update the offset
.BR
.TP
\fBvoid *\fR allocstr(\fBchar\fR **buffer, \fBsize_t\fR lentoadd);
Alloc/realloc buffer with lentoadd
.EX
return: 	NULL	=> libc error
		*buffer => Success
.EE
.BR
.TP
\fBvoid\fR *json_create(\fBstruct json\fR **j, \fBenum KIND\fR kind, \fBenum TYPE\fR type);
Create a json structure by kind, and set type. *j is set to the new position and return the entering *json.
.EX
return:	NULL		=> libc error
		struct json *	=> Success
.EE
.BR
.TP
\fBint\fR json_bool_test(\fBchar\fR *stock);
Test validity of boolean.
.EX
return:	0  => Success
		-6 => Invalid Boolean
.EE
.BR
.TP
\fBint\fR get_int(\fBstruct json_parser\fR *p, \fBint\fR init);
Read an number(/boolean) from the json buffer and return it.
.EX
return:	2 => Number need next character
		1 => Boolean need next chararcter
		0 => End of number/boolean (*p->stock != 0 invalid boolean)
		-1 => Number error fatal for RFC
		-2 => Invalid Number
.EE
.BR
.TP
\fBint\fR json_int_test(\fBchar\fR *stock, \fBchar\fR *pstock);
After \fIget_int()\fR, test the number.
.EX
return:	0  => Success
		-5 => Invalid number
		-7 => Invalid number fatal for RFC
.EE
.BR
.TP
\fBint\fR get_str(\fBstruct json_parser\fR *p);
Read an string from the json buffer and return it.
.EX
return:	0	=> end of string
		else	=> string length '\\' not computed inside
.EE
.BR
.TP
After the en of \fIget_int()\fR or \fIget_str()\fR
.EX
The first function to use is one of them:
\fBvoid\fR up_str_from_array(\fBstruct json\fR **j, \fBstruct json_parser\fR *p, \fBstruct fn\fR *f);
\fBvoid\fR up_str_from_pair(\fBstruct json\fR **j, \fBstruct json_parser\fR *p);
\fBvoid\fR up_from_int(\fBstruct json\fR **j, \fBstruct json_parser\fR *p, \fBstruct fn\fR *f);
The next function to use is one of them:
\fBvoid\fR up_structure_from_int_pair(\fBstruct json_parser\fR *p, \fBstruct json\fR *j);
\fBvoid\fR up_structure_from_int_array(\fBstruct json_parser\fR *p, \fBstruct json\fR *j, \fBstruct fn\fR *f);
\fBvoid\fR up_structure_from_str(\fBstruct json_parser\fR *p, \fBstruct fn\fR *f);
.EE
.BR
.TP
\fBint\fR starting(\fBstruct json_parser\fR *p, \fBstruct json\fR **j, \fBstruct fn\fR **f, \fBstruct json_new_lst\fR **nj);
Function for start parsing.
.EX
return:	-1 => Invalid data in JSON stream
		0  => Success
.EE
.BR
.TP
\fBint\fR array(\fBstruct json_parser\fR *p, \fBstruct json\fR **j, \fBstruct fn\fR **f, \fBstruct json_new_lst\fR **nj);
Read an array detected in json buffer.
.EX
return	-2 => Array error
		0 => Success
.EE
.BR
.TP
\fBint\fR pair(\fBstruct json_parser\fR *p, \fBstruct json\fR **j, \fBstruct fn\fR **f, \fBstruct json_new_lst\fR **nj);
Read an pair(keys) detected in json buffer.
.EX
return	-3 => JSON object error
		0 => Success
.EE
.BR
.TP
\fBint\fR json_errors(\fBstruct json_parser\fR *p, \fBstruct json\fR **j, \fBstruct fn\fR **f);
Print to stderr the json error string
.EX
return json_err.
.EE
.BR
.TP
\fBint\fR json_sort_asc(\fBstruct json\fR **j, \fBint\fR warn_only);
Sort a json pair list in ascendent.
return 0 or 1 if duplicate key found.
.BR
.TP
\fBint\fR json_sort_dsc(\fBstruct json\fR **j, \fBint\fR warn_only);
Sort a json pair list in descendent.
return 0 or 1 if duplicate key found.
.BR
.TP
\fBint\fR json_test(\fBstruct json\fR **j, \fBint\fR warn_only);
Test for duplicate keys.
.EX
Do in \fIjson_sort_*()\fR
return 0 or 1 if a duplicate key is found.
.EE
.BR
.TP
\fBssize_t\fR json_test_sort(\fBstruct json\fR **j, \fBint\fR (*sorting)(struct json **, int), \fBint\fR warn_only);
Sort the current *j.
.EX
\fB(*sorting)()\fR can be one of them:
\fBint\fR json_sort_asc(\fBstruct json\fR **j, \fBint\fR warn_only);
\fBint\fR json_sort_dsc(\fBstruct json\fR **j, \fBint\fR warn_only);
\fBint\fR json_test(\fBstruct json\fR **j, \fBint\fR warn_only);
.EE
.EX
warn_only:
1	=> just emit warning.
0	=> return -1 on duplicate key or malformed number
-1	=> no warning, never return -1
.EE
.BR
.TP
\fBvoid\fR json_print(\fBstruct json\fR *j, \fBsize_t\fR space, \fBchar\fR *sep, \fBchar\fR c_sp, \fBsize_t\fR count);
Print FD in json format.
.EX
\fIspace\fR is the number of \fIc_sp\fR used for space.
if \fIc_sp\fR == 0 no space are appliqued
char *sep = ":" : at minimal and good.
.EE
.BR
.TP
\fBint\fR json2txt(\fBstruct json\fR *j, \fBchar\fR *string);
Print FD in the form text.
.BR
.TP
\fBint\fR json_destroy(\fBstruct json\fR **j);
Destroy the json structure
.BR
